# Copy this file to .env.local and fill in your own values.

# A long, random string used to sign admin session cookies. Required in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Initial admin account (only used the first time the database is created).
# If you don't set these, a default admin/changeme123 account is created —
# change the password immediately from Admin > Settings after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
